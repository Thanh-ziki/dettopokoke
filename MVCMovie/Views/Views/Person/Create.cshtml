@model MVCMovie.Models.PersonClass

<h2>Thêm người mới</h2>

<form asp-action="Create" method="post">
    <label>Tên:</label>
    <input asp-for="Name" required /><br>

    <label>Họ và Tên:</label>
    <input asp-for="FullName" required /><br>

    <label>Địa chỉ:</label>
    <input asp-for="Address" required /><br>

    <button type="submit">Lưu</button>
</form>
